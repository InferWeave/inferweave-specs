{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/routing/capability-request.json",
  "title": "Capability request",
  "description": "What a client needs from a model (specs/60). A closed object: an unknown field is rejected so a hard constraint is never silently dropped. Non-binding growth goes in extensions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability",
    "quality_floor",
    "min_context_tokens",
    "modality",
    "deadline",
    "open_weight_only"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "capability": {
      "description": "Namespaced extensible capability id of specs/44, for example llm.tool_use.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "quality_floor": {
      "description": "Minimum acceptable value of one generic quality metric of specs/44. Never relaxed to win a slot.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "minimum"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "minimum": {
          "type": "number"
        }
      }
    },
    "min_context_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "modality": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "deadline": {
      "description": "Latest time by which serving must have started.",
      "type": "string",
      "format": "date-time"
    },
    "affinity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        }
      }
    },
    "open_weight_only": {
      "type": "boolean"
    },
    "extensions": {
      "$ref": "../common/extensions.json"
    }
  }
}
