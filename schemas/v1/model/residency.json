{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/model/residency.json",
  "title": "Model residency",
  "description": "A model variant occupying resources somewhere.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "residency_id",
    "state"
  ],
  "properties": {
    "residency_id": {
      "type": "string",
      "minLength": 1
    },
    "model_variant_id": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "absent",
        "downloading",
        "cached",
        "staging",
        "loading",
        "warming",
        "ready",
        "degraded",
        "draining",
        "unloading",
        "failed"
      ]
    },
    "node_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "runtime_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "startup_estimate_ms": {
      "type": "number",
      "minimum": 0
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "$ref": "../common/extensions.json"
    }
  }
}
