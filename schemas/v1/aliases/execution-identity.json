{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/aliases/execution-identity.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "principal_id",
    "grant_revision",
    "operation_id",
    "request_id",
    "request_fingerprint",
    "deadline_unix_ms"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "grant_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22,128}$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "request_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "deadline_unix_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
