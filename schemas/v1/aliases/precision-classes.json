{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/aliases/precision-classes.json",
  "title": "Alias precision-class table (spec 61)",
  "description": "Versioned, additive classification of a quantization token into a nominal weight bit-width band. A later version may add tokens and never moves a token between classes. A token outside the table is `unknown`. This file is both a Draft-07 schema of its own shape and the table data (`versions`); a consumer reads `versions`.",
  "definitions": {
    "band": {
      "$ref": "contract.json#/definitions/precision_band"
    },
    "token": {
      "$ref": "contract.json#/definitions/precision_token"
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "classes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "full": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/token"
              }
            },
            "high": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/token"
              }
            },
            "medium": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/token"
              }
            },
            "low": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/token"
              }
            },
            "very_low": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/token"
              }
            }
          },
          "required": [
            "full",
            "high",
            "medium",
            "low",
            "very_low"
          ]
        }
      },
      "required": [
        "version",
        "classes"
      ]
    }
  },
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/version"
      }
    }
  },
  "required": [
    "versions"
  ],
  "versions": [
    {
      "version": 1,
      "classes": {
        "full": [
          "fp32",
          "bf16",
          "fp16"
        ],
        "high": [
          "q8",
          "q8_0",
          "q8_k_xl",
          "fp8",
          "fp8_e4m3fn",
          "int8"
        ],
        "medium": [
          "q6_k",
          "q6_k_xl",
          "q5_0",
          "q5_1",
          "q5_k_m"
        ],
        "low": [
          "q4_0",
          "q4_1",
          "q4_k_m",
          "q4_k_xl",
          "mxfp4",
          "nvfp4"
        ],
        "very_low": [
          "q3_k_m",
          "q2_k"
        ]
      }
    }
  ]
}
