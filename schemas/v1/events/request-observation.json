{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/events/request-observation.json",
  "title": "Internal normalized terminal request observation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "iw.observability.request/1"
    },
    "visibility": {
      "const": "internal"
    },
    "metric_definition_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x7e]+$"
    },
    "source_gateway_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x7e]+$"
    },
    "producer_epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x7e]+$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "dataset": {
      "enum": [
        "production",
        "controlled",
        "unknown"
      ]
