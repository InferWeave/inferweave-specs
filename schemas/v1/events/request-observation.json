        "reason_code": {
          "enum": [
            "none",
            "unknown",
            "PROTOCOL_VERSION_UNSUPPORTED",
            "FEATURE_UNSUPPORTED",
            "MODEL_NOT_FOUND",
            "MODEL_UNAVAILABLE",
            "MODEL_NO_CAPACITY",
            "MODEL_LOADING",
            "MODEL_FAILED",
            "NO_COMPATIBLE_WORKER",
            "NO_CAPACITY",
            "QUEUE_FULL",
            "NODE_UNAVAILABLE",
            "RUNTIME_UNAVAILABLE",
            "RUNTIME_CRASHED",
            "ALLOCATION_PENDING",
            "ALLOCATION_PREEMPTED",
            "ALLOCATION_TERMINATED",
            "DEADLINE_EXCEEDED",
            "REQUEST_CANCELLED",
            "UPSTREAM_UNAVAILABLE",
            "BACKEND_UNREACHABLE",
            "BACKEND_TIMEOUT",
            "BACKEND_STREAM_FAILED",
            "CLIENT_CANCELLED",
            "INVALID_UPSTREAM_RESPONSE",
