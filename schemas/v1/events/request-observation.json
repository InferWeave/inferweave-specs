                  "const": "offset_from_start"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "first_visible_output"
                }
              }
            },
            "then": {
              "properties": {
                "semantics": {
                  "const": "offset_from_start"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "engine_prefill"
                }
              }
            },
            "then": {
              "properties": {
                "semantics": {
                  "const": "interval"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "engine_decode"
                }
              }
            },
            "then": {
              "properties": {
                "semantics": {
                  "const": "interval"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "engine_execution"
                }
              }
            },
            "then": {
              "properties": {
                "semantics": {
                  "const": "interval"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "completion"
                }
              }
            },
            "then": {
              "properties": {
                "semantics": {
                  "const": "offset_from_start"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "link_rtt"
                }
              }
            },
            "then": {
              "properties": {
                "semantics": {
                  "const": "round_trip"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "unattributed"
                }
              }
            },
            "then": {
              "properties": {
                "semantics": {
                  "const": "interval"
                }
              }
            }
          }
        ]
      }
