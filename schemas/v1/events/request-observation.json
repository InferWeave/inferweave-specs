              "route_processing",
              "connection_acquire",
              "dns",
              "tcp_connect",
              "tls_handshake",
              "upload",
              "writer_queue",
              "upstream_wait",
              "response_headers",
              "first_sse_event",
              "first_useful_output",
              "first_visible_output",
              "engine_prefill",
              "engine_decode",
              "engine_execution",
              "completion",
              "link_rtt",
              "unattributed"
