  "definitions": {
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "basis": {
          "enum": [
            "measured",
            "derived",
            "estimated",
            "declared",
            "unknown",
            "unsupported"
          ]
        },
        "source": {
          "enum": [
            "local_monotonic",
            "engine_reported",
            "http_first_token_proxy",
            "runtime_usage",
            "tokenizer",
            "configuration",
            "legacy_unknown",
            "unknown",
            "unsupported"
          ]
        }
      },
      "required": [
        "basis",
        "source"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "basis": {
                "enum": [
                  "unknown",
                  "unsupported"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          },
          "else": {
            "required": [
              "value"
            ]
          }
        }
      ]
    },
