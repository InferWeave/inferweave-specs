        {
          "type": "null"
        }
      ]
    },
    "observation_kind": {
      "enum": [
        "ingress_terminal",
        "attempt_terminal",
        "hop_terminal"
      ]
    },
    "sampling": {
      "enum": [
        "all_terminal",
        "diagnostic_only"
      ]
