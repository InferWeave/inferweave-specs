        "phase": {
          "enum": [
            "queue",
            "connect",
            "prefill",
            "decode",
            "execution",
            "unknown",
            "none"
          ]
        }
      },
      "required": [
        "status",
        "http_status",
        "completion",
        "reason_code",
        "layer",
        "phase"
      ]
    },
