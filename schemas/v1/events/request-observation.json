          "span_id",
          "parent_span_id",
          "phase",
          "measurement",
          "clock",
          "semantics"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "local_queue"
                }
              }
            },
            "then": {
              "properties": {
                "semantics": {
                  "const": "interval"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "route_processing"
                }
              }
            },
            "then": {
              "properties": {
                "semantics": {
                  "const": "interval"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "connection_acquire"
                }
              }
            },
            "then": {
              "properties": {
                "semantics": {
                  "const": "interval"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "dns"
                }
              }
            },
            "then": {
              "properties": {
                "semantics": {
                  "const": "interval"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "tcp_connect"
                }
              }
            },
            "then": {
              "properties": {
                "semantics": {
                  "const": "interval"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "tls_handshake"
                }
              }
            },
            "then": {
              "properties": {
                "semantics": {
                  "const": "interval"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "upload"
                }
              }
            },
            "then": {
              "properties": {
                "semantics": {
                  "const": "interval"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "writer_queue"
                }
              }
            },
            "then": {
              "properties": {
                "semantics": {
                  "const": "interval"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "upstream_wait"
                }
              }
            },
            "then": {
              "properties": {
                "semantics": {
                  "const": "inclusive_wait"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "response_headers"
                }
              }
            },
            "then": {
              "properties": {
                "semantics": {
                  "const": "offset_from_start"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "first_sse_event"
                }
              }
            },
            "then": {
              "properties": {
                "semantics": {
                  "const": "offset_from_start"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "first_useful_output"
                }
              }
            },
            "then": {
