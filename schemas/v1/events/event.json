{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/events/event.json",
  "title": "Event",
  "description": "A first-class protocol event.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "event_id",
    "event_type",
    "source_id",
    "sequence",
    "timestamp"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "number",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "causation_id": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "extensions": {
      "$ref": "../common/extensions.json"
    }
  }
}
