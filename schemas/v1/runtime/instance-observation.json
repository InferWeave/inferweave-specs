{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/runtime/instance-observation.json",
  "title": "Generation-bound runtime producer observation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "deployment_fingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "generation": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "source_epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "observed_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lifecycle": {
      "enum": [
        "UNKNOWN",
        "LOADING",
        "READY",
        "DRAINING",
        "FAILED",
        "UNLOADED"
      ]
    },
    "health": {
      "enum": [
        "UNKNOWN",
        "HEALTHY",
        "DEGRADED",
        "UNHEALTHY"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "$ref": "../aliases/contract.json#/definitions/family"
        },
        "input_modalities": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "$ref": "../aliases/contract.json#/definitions/modality"
          }
        },
        "output_modalities": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "$ref": "../aliases/contract.json#/definitions/modality"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "context_tokens_per_slot": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "parallel_slots": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "context_tokens_per_slot",
            "parallel_slots"
          ]
        },
        "confidence": {
          "enum": [
            "advertised",
            "observed"
          ]
        }
      },
      "required": [
        "family",
        "input_modalities",
        "output_modalities",
        "limits",
        "confidence"
      ]
    }
  },
  "required": [
    "instance_id",
    "model_id",
    "deployment_fingerprint",
    "generation",
    "source_epoch",
    "sequence",
    "observed_at_ms",
    "expires_at_ms",
    "lifecycle",
    "health",
    "capabilities"
  ]
}
