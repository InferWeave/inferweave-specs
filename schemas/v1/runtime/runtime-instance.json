{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/runtime/runtime-instance.json",
  "title": "Runtime instance",
  "description": "An active inference runtime instance.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "runtime_id",
    "runtime_type"
  ],
  "properties": {
    "runtime_id": {
      "type": "string",
      "minLength": 1
    },
    "runtime_type": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capabilities": {
      "$ref": "../model/capabilities.json"
    },
    "resident_models": {
      "type": "array",
      "items": {
        "$ref": "../model/residency.json"
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": true
    },
    "extensions": {
      "$ref": "../common/extensions.json"
    }
  }
}
