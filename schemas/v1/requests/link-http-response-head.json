{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/requests/link-http-response-head.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "content_type"
  ],
  "properties": {
    "status": {
      "type": "integer",
      "minimum": 200,
      "maximum": 599,
      "not": {
        "minimum": 300,
        "maximum": 399
      }
    },
    "content_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[\\x20-\\x7e\\t]+$"
    },
    "headers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x-inferweave-request-id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[!-~]+$"
        },
        "retry-after": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,9})$"
        }
      }
    }
  }
}
