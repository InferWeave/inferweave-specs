{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/requests/link-consume-dispatch-ack.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "invocation_id",
    "node_id",
    "link_incarnation_id",
    "claim_authority_id",
    "claim_id",
    "owner_incarnation",
    "holder_id",
    "fencing_token",
    "admission_attempt",
    "reservation_id",
    "permit_transcript_sha256",
    "outcome"
  ],
  "properties": {
    "kind": {
      "const": "consume_dispatch_ack"
    },
    "version": {
      "const": 1
    },
    "invocation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "link_incarnation_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[!-~]+$"
    },
    "claim_authority_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "owner_incarnation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "holder_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "admission_attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "reservation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "permit_transcript_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outcome": {
      "enum": [
        "NEWLY_CONSUMED",
        "ALREADY_CONSUMED",
        "REJECTED"
      ]
    }
  }
}
