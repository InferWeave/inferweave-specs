{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/requests/node-provisioning-status.json",
  "title": "Dynamic node provisioning status (the `provisioning` member of POST /v1/node/heartbeat)",
  "description": "One entry per assignment a dynamic node has acted on (specs/64_DYNAMIC_NODES_AND_GATEWAY_PROVISIONING.md section 6). Read leniently by the gateway after the beat is accepted; a malformed entry is dropped, never a refused beat. The member is an array of these; the 65536-byte bound is a size rule the schema cannot express.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "model", "gpuIds", "phase", "updatedAt"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "model": {"type": "string", "maxLength": 200},
    "gpuIds": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "phase": {
      "type": "string",
      "enum": ["pending", "fetching", "launching", "probing", "serving", "measuring", "measured", "failed", "stopped"]
    },
    "updatedAt": {"type": "integer", "minimum": 0},
    "bytesDone": {"type": "integer", "minimum": 0},
    "bytesTotal": {"type": "integer", "minimum": 0},
    "endpoint": {"type": "string", "minLength": 1, "maxLength": 1024},
    "deployment": {"type": "string", "pattern": "^dep_[0-9a-f]{64}$"},
    "cellsDone": {"type": "integer", "minimum": 0},
    "cellsTotal": {"type": "integer", "minimum": 0},
    "evidence": {"type": "array", "maxItems": 64, "items": {"$ref": "#/definitions/evidence"}},
    "readySec": {"type": "number", "minimum": 0},
    "reason": {
      "type": "string",
      "enum": ["refused", "artifact_unavailable", "digest_mismatch", "disk_full", "launch_failed", "probe_failed", "engine_exited", "measure_failed"]
    },
    "message": {"type": "string", "maxLength": 1024}
  },
  "allOf": [
    {"if": {"properties": {"phase": {"const": "fetching"}}}, "then": {"required": ["bytesDone", "bytesTotal"]}},
    {"if": {"properties": {"phase": {"const": "serving"}}}, "then": {"required": ["endpoint", "deployment"]}},
    {"if": {"properties": {"phase": {"const": "measuring"}}}, "then": {"required": ["cellsDone", "cellsTotal"]}},
    {"if": {"properties": {"phase": {"const": "measured"}}}, "then": {"required": ["evidence", "readySec"]}},
    {"if": {"properties": {"phase": {"const": "failed"}}}, "then": {"required": ["reason", "message"]}}
  ],
  "definitions": {
    "evidence": {
      "description": "One measured cell, as a runtime profile's evidence row: decodeTps is the aggregate decode rate across the cell's concurrent streams at the named context depth (specs/39, invariant 42).",
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "date", "context", "concurrency", "decodeTps"],
      "properties": {
        "run": {"type": "string", "maxLength": 128},
        "date": {"type": "string", "maxLength": 32},
        "context": {"type": "integer", "minimum": 1},
        "concurrency": {"type": "integer", "minimum": 1},
        "decodeTps": {"type": "number", "minimum": 0},
        "prefillTps": {"type": "number", "minimum": 0},
        "ttftP50Ms": {"type": "number", "minimum": 0}
      }
    }
  }
}
