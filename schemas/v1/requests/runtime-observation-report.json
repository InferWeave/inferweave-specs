{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/requests/runtime-observation-report.json",
  "title": "Optional authenticated node runtime observation snapshot",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "observed_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "complete": {
      "const": true
    },
    "instances": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "observation": {
            "$ref": "../runtime/instance-observation.json"
          },
          "required_gpu_ids": {
            "type": "array",
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "owner_policy_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "qualification_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "observation",
          "required_gpu_ids"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "source_epoch",
    "sequence",
    "observed_at_ms",
    "expires_at_ms",
    "complete",
    "instances"
  ]
}
