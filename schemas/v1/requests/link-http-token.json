{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/requests/link-http-token.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "request_id",
    "seq",
    "payload"
  ],
  "properties": {
    "kind": {
      "const": "token"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "payload": {
      "type": "string",
      "maxLength": 1048576
    },
    "response_head": {
      "$ref": "link-http-response-head.json"
    },
    "queue_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "queue_hops": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hop",
          "ms"
        ],
        "properties": {
          "hop": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+(?![\\s\\S])"
          },
          "ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    }
  }
}
