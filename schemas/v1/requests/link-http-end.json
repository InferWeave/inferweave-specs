{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/requests/link-http-end.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "request_id"
  ],
  "properties": {
    "kind": {
      "const": "end"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "failure": {
      "$ref": "link-http-failure.json"
    }
  }
}
