{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/requests/link-http-failure.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "retryable"
  ],
  "properties": {
    "code": {
      "enum": [
        "BACKEND_UNREACHABLE",
        "BACKEND_TIMEOUT",
        "BACKEND_STREAM_FAILED",
        "CLIENT_CANCELLED",
        "INVALID_UPSTREAM_RESPONSE"
      ]
    },
    "retryable": {
      "const": false
    }
  }
}
