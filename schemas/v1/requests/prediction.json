{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/requests/prediction.json",
  "title": "Prediction request",
  "type": "object",
  "additionalProperties": true,
  "required": ["family", "model", "inputs"],
  "properties": {
    "family": {"type": "string", "enum": ["prediction"]},
    "model": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": true}}
  }
}
