{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/node-reconcile/permit.json",
  "title": "Managed node reconciliation permit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nodeId",
    "ownerEpoch",
    "policyId",
    "scopeId",
    "assignmentId",
    "deployment",
    "gpuIds",
    "environmentFingerprint",
    "version",
    "purpose",
    "permitId",
    "token",
    "issuedAt",
    "expiresAt",
    "maxRequests"
  ],
  "properties": {
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "ownerEpoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "policyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "scopeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "assignmentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "deployment": {
      "type": "string",
      "pattern": "^dep_[0-9a-f]{64}$"
    },
    "gpuIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "\\S"
      },
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true
    },
    "environmentFingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S",
      "description": "Opaque exact identity of the existing qualification environment; compare verbatim, never treat this identifier as authority."
    },
    "version": {
      "type": "integer",
      "const": 1
    },
    "purpose": {
      "const": "inferweave.node-qualification/1"
    },
    "permitId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "token": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issuedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxRequests": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    }
  }
}
