{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/resources/gpu-memory-postmortem.json",
  "title": "GpuMemoryPostmortem",
  "type": "object",
  "description": "Payload of gpu.memory.postmortem (spec 46 §7.3): the last pre-failure state of the GPU, kept by the node so the OOM can be reconstructed without the failed runtime.",
  "properties": {
    "resourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x7e]*$",
      "description": "Printable ASCII without spaces, so 128 characters is 128 UTF-8 bytes on every reader."
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x7e]*$",
      "description": "Printable ASCII without spaces, so 128 characters is 128 UTF-8 bytes on every reader."
    },
    "capturedAt": {
      "type": "string",
      "description": "UTC ISO-8601 timestamp (producer clock; display only)."
    },
    "reportSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "gpu": {
      "$ref": "gpu-memory-gpu.json"
    },
    "runtimes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "gpu-memory-runtime.json"
      }
    },
    "allocations": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "gpu-memory-allocation.json"
      }
    },
    "ownership": {
      "$ref": "gpu-memory-report.json#/properties/ownership"
    },
    "pressure": {
      "$ref": "pressure.json"
    },
    "recentGrowth": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "description": "UTC ISO-8601 timestamp (producer clock; display only)."
          },
          "usedBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "at"
        ],
        "additionalProperties": true
      }
    },
    "recentDecisions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "decisionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[\\x21-\\x7e]*$",
            "description": "Printable ASCII without spaces, so 128 characters is 128 UTF-8 bytes on every reader."
          },
          "action": {
            "type": "string",
            "enum": [
              "pack",
              "move",
              "evict",
              "consolidate",
              "restore",
              "scale_up",
              "scale_down",
              "place",
              "repack",
              "rebalance",
              "renew",
              "hold",
              "give_back",
              "suspend"
            ]
          },
          "decidedAt": {
            "type": "string",
            "description": "UTC ISO-8601 timestamp (producer clock; display only)."
          },
          "outcome": {
            "type": "string",
            "enum": [
              "pending",
              "succeeded",
              "failed",
              "expired",
              "rolled_back"
            ]
          }
        },
        "required": [
          "decisionId",
          "action"
        ],
        "additionalProperties": true
      }
    },
    "runtimeError": {
      "type": "object",
      "properties": {
        "exitStatus": {
          "type": "integer"
        },
        "signal": {
          "type": "string",
          "maxLength": 16
        },
        "signature": {
          "type": "string",
          "maxLength": 64
        },
        "stderrTail": {
          "type": "string",
          "maxLength": 2048,
          "description": "At most 2 KiB, matched against OOM signatures and scrubbed by the secret filters; never prompts."
        }
      },
      "additionalProperties": true
    }
  },
  "required": [
    "resourceId",
    "nodeId",
    "capturedAt",
    "gpu"
  ],
  "additionalProperties": true
}
