{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/resources/memory.json",
  "title": "GPU memory",
  "description": "Explicit GPU memory accounting. Unknown remains unknown, never 0.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "total": {
      "type": "number",
      "minimum": 0
    },
    "weights": {
      "type": "number",
      "minimum": 0
    },
    "kv_cache": {
      "type": "number",
      "minimum": 0
    },
    "runtime_cache": {
      "type": "number",
      "minimum": 0
    },
    "active_requests": {
      "type": "number",
      "minimum": 0
    },
    "reserved": {
      "type": "number",
      "minimum": 0
    },
    "other_models": {
      "type": "number",
      "minimum": 0
    },
    "system": {
      "type": "number",
      "minimum": 0
    },
    "unaccounted": {
      "type": "number",
      "minimum": 0
    },
    "free": {
      "type": "number",
      "minimum": 0
    }
  }
