{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/resources/gpu-memory-anomaly.json",
  "title": "GpuMemoryAnomaly",
  "type": "object",
  "description": "An accounting reconciliation failure (spec 46 §3.8).",
  "properties": {
    "anomalyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "resourceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "kind": {
      "type": "string",
      "enum": [
        "physical-sum-mismatch",
        "attribution-sum-mismatch",
        "unattributed-over-tolerance",
        "negative-derived",
        "reservation-stale",
        "slot-sum-exceeds-pool",
        "per-process-exceeds-card"
      ]
    },
    "measuredBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "toleranceBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "firstSeenAt": {
      "type": "string",
      "description": "UTC ISO-8601 timestamp (producer clock; display only)."
    },
    "lastSeenAt": {
      "type": "string",
      "description": "UTC ISO-8601 timestamp (producer clock; display only)."
    },
    "consecutive": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "detail": {
      "type": "string",
      "maxLength": 512
    }
  },
  "required": [
    "anomalyId",
    "resourceId",
    "kind"
  ],
  "additionalProperties": true
}
