{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/resources/gpu-memory-fleet.json",
  "title": "GpuMemoryFleet",
  "type": "object",
  "description": "What a gateway serves on GET /iw/v1/gpu-memory (spec 46 §4). Consumers de-duplicate GPUs by resourceId across paths and never sum copies.",
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "iw.gpu-memory.fleet/1"
      ]
    },
    "gatewayId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "producerEpoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "generatedAt": {
      "type": "string",
      "description": "This gateway's clock; consumers stamp their own receipt time."
    },
    "authority": {
      "type": "object",
      "properties": {
        "rebalancer": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "off",
            "observe",
            "shadow",
            "on"
          ]
        }
      },
      "required": [
        "rebalancer",
        "mode"
      ],
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "gpu-memory-report.json"
      }
    },
    "reservations": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "reservation.json"
      }
    },
    "peers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "gatewayId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "type": "string",
            "enum": [
              "fresh",
              "stale",
              "unreachable",
              "unsupported"
            ]
          },
          "receivedAgeMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "capabilities": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 128
            }
          }
        },
        "required": [
          "gatewayId",
          "status"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema",
    "gatewayId",
    "producerEpoch",
    "sequence",
    "generatedAt",
    "authority",
    "nodes"
  ],
  "additionalProperties": true
}
