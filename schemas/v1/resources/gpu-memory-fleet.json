{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/resources/gpu-memory-fleet.json",
  "title": "GpuMemoryFleet",
  "type": "object",
  "description": "What a gateway serves on GET /iw/v1/gpu-memory (spec 46 §4). Consumers de-duplicate GPUs by resourceId across paths and never sum copies.",
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "iw.gpu-memory.fleet/1"
      ]
    },
    "gatewayId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x2e\\x30-\\x7e]*$",
      "description": "A node or gateway id: printable ASCII without spaces and without '/', the separator of GPU resource ids."
    },
    "producerEpoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x7e]*$",
      "description": "Printable ASCII without spaces, so 128 characters is 128 UTF-8 bytes on every reader."
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "generatedAt": {
      "type": "string",
      "description": "This gateway's clock; consumers stamp their own receipt time."
    },
    "authority": {
      "type": "object",
      "properties": {
        "rebalancer": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "off",
            "observe",
            "shadow",
            "on"
          ]
        }
      },
      "required": [
        "rebalancer",
        "mode"
      ],
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "gpu-memory-report.json"
      }
    },
    "reservations": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "reservation.json"
      }
    },
    "servedAgeMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Milliseconds from generatedAt to the moment this response was served (producer clock). Consumers add it to the data's age; a paginated response without it is stale."
    },
    "nodeCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Nodes across every page of this sequence, so a consumer can tell a large valid fleet from a malformed one."
    },
    "nextCursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x7e]*$",
      "description": "Present when the snapshot did not fit its caps: fetch the next page with ?cursor=<nextCursor>. Every page carries the same producerEpoch and sequence."
    },
    "peers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "gatewayId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[\\x21-\\x2e\\x30-\\x7e]*$",
            "description": "A node or gateway id: printable ASCII without spaces and without '/', the separator of GPU resource ids."
          },
          "status": {
            "type": "string",
            "enum": [
              "fresh",
              "stale",
              "unreachable",
              "unsupported"
            ]
          },
          "receivedAgeMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "capabilities": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 128
            }
          }
        },
        "required": [
          "gatewayId",
          "status"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema",
    "gatewayId",
    "producerEpoch",
    "sequence",
    "generatedAt",
    "authority",
    "nodes"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "required": [
          "nextCursor"
        ]
      },
      "then": {
        "required": [
          "nodeCount"
        ]
      }
    }
  ]
}
