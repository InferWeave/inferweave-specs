{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/deployments/deployment.json",
  "title": "Deployment",
  "description": "Canonical deployment manifest and live placement projection. deployment_key is additive for mixed-version compatibility and is required when runtime_lifecycle/1 is negotiated.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "deployment_id", "modality", "model", "runtime"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["inferweave.deployment/v1"]},
    "deployment_id": {"type": "string", "minLength": 1},
    "deployment_key": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "modality": {"type": "string", "minLength": 1},
    "model": {"type": "object", "additionalProperties": true},
    "tokenizer": {"type": "object", "additionalProperties": true},
    "runtime": {"type": "object", "additionalProperties": true},
    "precision": {"type": "object", "additionalProperties": true},
    "context": {"type": "object", "additionalProperties": true},
    "execution": {"type": "object", "additionalProperties": true},
    "resource_envelope": {"type": "object", "additionalProperties": true},
    "policy": {"type": "object", "additionalProperties": true},
    "license": {"type": "object", "additionalProperties": true},
    "validation": {"type": "object", "additionalProperties": true},
    "instances": {"type": "array", "items": {"$ref": "../runtime/runtime-instance.json"}},
    "assignment": {"$ref": "../topology/allocation.json"},
    "placement_reason": {"type": "string"}
  }
}
