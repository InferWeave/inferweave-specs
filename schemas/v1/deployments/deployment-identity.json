{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/deployments/deployment-identity.json",
  "title": "DeploymentIdentity",
  "description": "Exact immutable digest input for deployment_key. Encode this object as RFC 8785 JCS UTF-8, hash those bytes with SHA-256, and prefix the lowercase hex digest with sha256:. Live placement and instance fields are outside this object.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "modality", "model", "artifacts", "runtime", "effective_profile", "policy", "resource_contract"],
  "properties": {
    "schema_version": {"type": "string", "const": "inferweave.deployment-identity/v1"},
    "modality": {"type": "string", "minLength": 1},
    "model": {"type": "object", "minProperties": 1, "additionalProperties": true},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "minProperties": 1, "additionalProperties": true}},
    "runtime": {"type": "object", "minProperties": 1, "additionalProperties": true},
    "effective_profile": {"type": "object", "minProperties": 1, "additionalProperties": true},
    "policy": {"type": "object", "additionalProperties": true},
    "resource_contract": {"type": "object", "minProperties": 1, "additionalProperties": true}
  }
}
