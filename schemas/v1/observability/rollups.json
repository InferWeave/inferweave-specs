{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inferweave.dev/schemas/v1/observability/rollups.json",
  "title": "Private observability rollups",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "iw.observability.rollups-page/1"
    },
    "visibility": {
      "const": "internal"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[\\x21-\\x7e]+$"
    },
    "as_of": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "source_gateway_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[\\x21-\\x7e]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[\\x21-\\x7e]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cluster_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[\\x21-\\x7e]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime_instance_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[\\x21-\\x7e]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "gpu_resource_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[\\x21-\\x7e]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution_seconds": {
          "enum": [
            300,
            3600,
            86400
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "dataset": {
          "anyOf": [
            {
              "enum": [
                "production",
                "controlled",
                "unknown"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "observation_kind": {
          "anyOf": [
            {
              "enum": [
                "ingress_terminal",
                "attempt_terminal",
                "hop_terminal"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "lineage_scope": {
          "anyOf": [
            {
              "enum": [
                "trusted",
                "local_unlinked"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "start",
        "end",
        "source_gateway_id",
        "model_id",
        "cluster_id",
        "runtime_instance_id",
        "gpu_resource_id",
        "resolution_seconds",
        "limit",
        "dataset",
        "observation_kind",
        "lineage_scope"
      ]
    },
    "query_health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "available",
            "partial",
            "unavailable"
          ]
        },
        "reason": {
          "enum": [
            "none",
            "source_coverage_unknown",
            "retention_boundary",
            "storage_unavailable",
            "snapshot_unavailable",
            "failure_companion_unavailable",
            "invalid_record"
          ]
        }
      },
      "required": [
        "status",
        "reason"
      ]
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "parent": {
            "$ref": "https://inferweave.dev/schemas/v1/events/request-observation-rollup.json"
          },
          "failure": {
            "anyOf": [
              {
                "$ref": "https://inferweave.dev/schemas/v1/events/request-observation-failure-rollup.json"
              },
              {
                "type": "null"
              }
            ]
          },
          "failure_availability": {
            "enum": [
              "available",
              "unavailable"
            ]
          }
        },
        "required": [
          "parent",
          "failure",
          "failure_availability"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "failure_availability": {
                  "const": "available"
                }
              }
            },
            "then": {
              "properties": {
                "failure": {
                  "type": "object"
                }
              }
            },
            "else": {
              "properties": {
                "failure": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "visibility",
    "snapshot_id",
    "as_of",
    "expires_at",
    "query",
    "query_health",
    "next_cursor",
    "items"
  ]
}
