  "requestSizeCases": {
    "$comment": "Spec 47 section 6.6 (SHOULD). An authenticated or unauthenticated caller sends padding; the gateway refuses before parsing. statusIn lists the permitted statuses.",
    "cases": [
      {
        "id": "register-body-over-256k",
        "route": "/v1/node/register",
        "bodyBytes": 307200,
        "expect": {
          "statusIn": [
            400,
            413
          ]
        }
      },
      {
        "id": "challenge-body-over-16k",
        "route": "/v1/node/challenge",
        "bodyBytes": 20480,
        "expect": {
          "statusIn": [
            400,
            413
          ]
        }
      },
      {
        "id": "register-body-under-caps",
