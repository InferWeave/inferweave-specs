    "$comment": "Spec 47 sections 6.2, 6.4, 3.1 rule 8, 6.6. HTTP-level step sequences replayed against one fresh gateway per case. `known` ops make an id known to the gateway (static catalog, live fleet or controller instance) by whatever test hook the gateway has. `cred` names a credential held by the test: `proof1` earned by tokenless proof, `operator1` issued by operator enrollment. `conn` names a connectionId returned by an earlier register.",
    "cases": [
      {
        "id": "promotion-evicts-proof-squatter",
        "steps": [
          {
            "op": "proof_enroll",
            "node": "node_pro-1",
            "cred": "proof1",
            "expect": {
              "status": 200
            }
          },
          {
            "op": "register",
            "node": "node_pro-1",
            "cred": "proof1",
            "hardware": true,
            "endpoint": false,
            "saveConn": "conn1",
            "expect": {
              "status": 200
            }
          },
          {
            "op": "operator_enroll",
            "node": "node_pro-1",
            "cred": "operator1",
            "code": "valid",
            "expect": {
              "status": 200
            }
          },
          {
            "op": "register",
            "node": "node_pro-1",
            "cred": "proof1",
            "hardware": true,
            "endpoint": false,
            "expect": {
              "status": 401
            }
          },
          {
            "op": "heartbeat",
            "node": "node_pro-1",
            "conn": "conn1",
            "expect": {
              "status": 401
            }
          },
          {
            "op": "listing",
            "node": "node_pro-1",
            "expect": {
              "hardwarePresent": false
            }
          },
          {
            "op": "register",
            "node": "node_pro-1",
            "cred": "operator1",
            "hardware": false,
            "endpoint": true,
            "expect": {
              "status": 200
            }
          }
        ]
      },
      {
        "id": "invalid-operator-code-unseats-nobody",
        "steps": [
          {
            "op": "proof_enroll",
            "node": "node_pro-2",
            "cred": "proof1",
            "expect": {
              "status": 200
            }
          },
          {
            "op": "register",
            "node": "node_pro-2",
            "cred": "proof1",
            "hardware": true,
            "endpoint": false,
            "saveConn": "conn1",
            "expect": {
              "status": 200
            }
          },
          {
            "op": "operator_enroll",
            "node": "node_pro-2",
            "cred": "operator1",
            "code": "invalid",
            "expect": {
              "status": 401
            }
          },
          {
            "op": "heartbeat",
            "node": "node_pro-2",
            "conn": "conn1",
            "expect": {
              "status": 200
            }
          },
          {
            "op": "listing",
            "node": "node_pro-2",
            "expect": {
              "hardwarePresent": true
            }
          }
        ]
      },
      {
        "id": "proof-never-replaces-operator-credential",
        "steps": [
          {
            "op": "operator_enroll",
            "node": "node_pro-3",
            "cred": "operator1",
            "code": "valid",
            "expect": {
              "status": 200
            }
          },
          {
            "op": "proof_enroll",
            "node": "node_pro-3",
            "cred": "proof1",
            "expect": {
              "status": 403,
              "errorCode": "forbidden"
            }
          },
          {
            "op": "register",
            "node": "node_pro-3",
            "cred": "operator1",
            "hardware": false,
            "endpoint": true,
            "expect": {
              "status": 200
            }
          }
        ]
      },
      {
        "id": "challenge-for-known-id-is-refused",
        "steps": [
          {
            "op": "known",
