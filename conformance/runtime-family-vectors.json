{
  "$comment": "Spec 53 runtime-family conformance vectors (B-T06A, feature IW-RT-006). Advertisement/admission cases follow spec 48. Each family has executable positive and negative native request cases. Offline runs validate the request contract; only --live-base-url executes HTTP.",
  "spec": "specs/53_RUNTIME_FAMILY_CONFORMANCE.md",
  "version": 1,
  "featureId": "IW-RT-006",
  "registry": [
    "llm",
    "reasoning",
    "embeddings",
    "reranking",
    "stt",
    "tts",
    "audio",
    "prediction",
    "image",
    "video",
    "multimodal",
    "scientific",
    "rag"
  ],
  "requiredFamilies": [
    "embeddings",
    "reranking",
    "prediction",
    "stt",
    "rag"
  ],
  "families": {
    "embeddings": {
      "advertisement": {
        "family": "embeddings",
        "input_modalities": [
          "text"
        ],
        "output_modalities": [
          "vector"
        ],
        "quality": {
          "metric": "dimension",
          "value": 1024,
          "basis": "self-reported"
        }
      },
      "expect": {
        "admitted": true,
        "roundTrip": true
      },
      "rejections": [
        {
          "id": "embeddings-missing-family",
          "omit": [
            "family"
          ],
          "expect": {
            "admitted": false
          }
        },
        {
          "id": "embeddings-missing-modalities",
          "omit": [
            "input_modalities",
            "output_modalities"
          ],
          "expect": {
            "admitted": false
          }
        },
        {
          "id": "embeddings-unknown-family",
          "override": {
            "family": "not-a-family"
          },
          "expect": {
            "admitted": false
          }
        }
      ],
      "nativeCases": [
        {
          "id": "embeddings-success",
          "method": "POST",
          "path": "/embeddings",
          "body": {
            "family": "embeddings",
            "model": "embed-test",
            "input": [
              "hello"
            ]
          },
          "expectStatus": 200
        },
        {
          "id": "embeddings-family-mismatch",
          "method": "POST",
          "path": "/embeddings",
          "body": {
            "family": "reranking",
            "model": "embed-test",
            "input": [
              "hello"
            ]
          },
          "expectStatus": 400
        }
      ]
    },
