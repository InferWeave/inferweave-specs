      "CLAIMED",
      "RESERVED"
    ],
    [
      "RESERVED",
      "CLAIMED"
    ],
    [
      "RESERVED",
      "DISPATCHED"
    ],
    [
      "CLAIMED",
      "TERMINAL"
    ],
    [
      "RESERVED",
      "TERMINAL"
    ],
    [
      "DISPATCHED",
      "TERMINAL"
    ]
  ],
  "terminal_reopens": false,
  "dispatch_intent_before_send": true,
  "inference_credentials_forwarded": false,
