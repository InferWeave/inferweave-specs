    "body_sha256",
    "content_type",
    "alias_level",
    "session_id",
    "timeout_ms",
    "capabilities",
    "min_context",
    "prefer_family",
    "queue",
    "tenant_selector",
    "operation_id",
    "idempotency_key",
    "request_fingerprint",
    "deadline_unix_ms"
  ],
  "fingerprint_domain": "inferweave.alias-request-fingerprint/v1",
  "fingerprint_fields": [
    "method",
    "request_target",
    "body_sha256",
    "content_type",
    "alias_level",
    "session_id",
    "timeout_ms",
    "capabilities",
    "min_context",
