  "allowed_targets": [
    "/v1/chat",
    "/v1/chat/completions",
    "/v1/completions",
    "/v1/responses",
    "/v1/embeddings",
    "/v1/audio/transcriptions",
    "/v1/audio/speech",
    "/v1/rerank"
  ],
  "claim_states": [
