  "admin": {
    "context": "GET /iw/v1/routes/explain?model=<id>&tool_qualification_context=true",
    "reload": "POST /v1/admin/routes/reload?tool_qualifications=true",
    "authentication": "Caller::Admin only for tool context and trust reload; existing service-operator authorization does not grant tool trust authority",
    "atomicReload": true,
    "revision": "strictly increasing within installed owner policy; same owner required",
    "failedReload": "preserve previous policy",
    "snapshotFile": "private owner-owned regular file, no symlink, at most snapshotBytes"
  },
  "telemetry": {
    "decisionCounter": "iw_tool_qualification_decisions_total",
    "reloadCounter": "iw_tool_qualification_reloads_total",
    "labels": [
      "model",
      "profile",
      "runtime",
      "reason"
    ],
    "content": "no raw arguments, content, reasoning, credentials or private node/GPU identities",
    "cardinality": "bounded hashed profile/runtime groups; overflow collapsed",
    "retriesAdded": false,
    "dsmlConversion": false
  },
  "proofStatus": "owed",
  "proofScope": "Offline schemas/transcript/hostile vectors prove only their checks; runtime security, actual-model/GPU/Pi compatibility and production activation remain separate.",
  "dynamicFingerprintExtension": {
    "presence": "Absent toolCalling appends zero bytes; existing fingerprints remain byte-identical. Present toolCalling appends the fields below after the legacy payload.",
    "domain": "iw.runtime-tool-calling/1",
    "encoding": {
      "S": "u64 big-endian UTF-8 byte length followed by UTF-8 bytes",
      "N": "u64 big-endian number",
      "optional": "one byte 0 absent or 1 present followed by the encoded value",
      "support": "N count followed by lexically sorted serialized wire strings, each encoded with S"
    },
    "order": [
      "S(domain)",
      "N(schemaVersion)",
      "S(modeWire)",
      "S(engineRevision)",
      "optional parserPatchSha256:S",
      "optional parser:S(wireToken)",
      "optional reasoning:S(wireToken)",
      "optional template:S(path)+S(sha256)",
      "N(supportCount)",
      "S(eachSortedSupportWireToken)"
    ],
    "separateFromQualification": "Legacy dynamic fingerprint strings use u64 lengths; purpose-specific qualification/report strings use u32 lengths. Do not interchange these domains or encoders."
  },
  "admissionError": {
    "httpStatus": 503,
    "code": "tool_capability_unavailable",
    "condition": "No eligible instance satisfies the enabled exact-model tool hard filter",
    "behavior": "Refuse before indefinite queueing or automatic acquisition; do not retry or relax hard constraints",
    "distinctFrom": "Diagnostic ToolFailureCode reason vocabulary"
  }
