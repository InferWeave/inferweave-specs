    "46_GPU_MEMORY_INTELLIGENCE",
    "58_MODEL_INTELLIGENCE_UI_COHESION",
    "64_DYNAMIC_NODES_AND_GATEWAY_PROVISIONING"
  ],
  "features": [
    "IW-OBS-001",
    "IW-TEL-001",
    "IW-BENCH-002",
    "IW-UI-001",
    "IW-UI-002",
    "IW-GPUMEM-001"
  ],
  "canonical_tasks": [
    "P1-T05",
    "P1-T20",
    "P2-T03",
    "P1-T21",
